---
const countries = [
  { code: '+254', name: 'Kenya', flag: '🇰🇪' },
  { code: '+256', name: 'Uganda', flag: '🇺🇬' },
  { code: '+255', name: 'Tanzania', flag: '🇹🇿' },
  { code: '+250', name: 'Rwanda', flag: '🇷🇼' },
];

const fieldClass = 'w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-body-sm text-gray-900 placeholder:text-gray-400 transition-[border-color] duration-200 hover:border-gray-400 focus:border-primary-600 focus:outline-2 focus:outline-offset-0 focus:outline-primary-600/20';
const labelClass = 'text-body-sm text-gray-900';
---

<form id="contact-form" class="flex flex-col gap-6" novalidate>
  <div id="form-status" role="status" aria-live="polite" class="hidden rounded-lg border px-4 py-3 text-body-sm"></div>

  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <label for="name" class={labelClass}>Full Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required placeholder="John Doe" class={fieldClass} />
    </div>

    <div class="flex flex-col gap-1">
      <label for="email" class={labelClass}>Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required placeholder="johndoe@example.com" class={fieldClass} />
    </div>

    <div class="flex flex-col gap-1">
      <label for="phone" class={labelClass}>Phone Number</label>
      <div class="flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 transition-[border-color] duration-200 hover:border-gray-400 focus-within:border-primary-600 focus-within:outline-2 focus-within:outline-primary-600/20">
        <div class="relative flex shrink-0 items-center gap-1">
          <img id="country-flag" src="/images/new/flag-ke.svg" alt="" width="30" height="20" class="rounded-[1.818px]" />
          <span id="country-emoji" class="hidden w-7.5 text-center text-xl leading-5" aria-hidden="true"></span>
          <img src="/images/new/chevron-down-sm.svg" alt="" width="14" height="14" />
          <select id="country" name="country" aria-label="Country code" class="absolute inset-0 cursor-pointer opacity-0">
            {countries.map((c) => <option value={c.code} data-flag={c.flag}>{c.flag} {c.name} ({c.code})</option>)}
          </select>
        </div>
        <input id="phone" name="phone" type="tel" autocomplete="tel-national" required placeholder="712 345 678" class="w-full bg-transparent py-3 text-body-sm text-gray-900 outline-none placeholder:text-gray-400" />
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <label for="message" class={labelClass}>Message</label>
      <textarea id="message" name="message" required rows="3" placeholder="How can we help you today?" class:list={[fieldClass, 'h-25 resize-y']}></textarea>
    </div>
  </div>

  <button id="submit-btn" type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg border-2 border-primary-600 bg-primary-600 px-4 py-3 text-cta text-white transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:opacity-85 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 disabled:cursor-not-allowed disabled:opacity-60">
    <svg id="btn-spinner" class="hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
    <span id="btn-text">Send Message</span>
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const spinner = document.getElementById('btn-spinner');
  const country = document.getElementById('country') as HTMLSelectElement | null;
  const flagImg = document.getElementById('country-flag');
  const flagEmoji = document.getElementById('country-emoji');

  // Kenya uses the flag artwork from the design; other countries fall back to their emoji flag.
  country?.addEventListener('change', () => {
    const isKenya = country.value === '+254';
    flagImg?.classList.toggle('hidden', !isKenya);
    flagEmoji?.classList.toggle('hidden', isKenya);
    if (flagEmoji) flagEmoji.textContent = country.selectedOptions[0]?.dataset.flag ?? '';
  });

  function setLoading(loading: boolean) {
    if (submitBtn) submitBtn.disabled = loading;
    spinner?.classList.toggle('hidden', !loading);
    if (btnText) btnText.textContent = loading ? 'Sending…' : 'Send Message';
  }

  function showStatus(kind: 'success' | 'error', message: string, errors: string[] = []) {
    if (!status) return;
    status.className = kind === 'success'
      ? 'rounded-lg border border-secondary-800/30 bg-secondary-800/5 px-4 py-3 text-body-sm text-secondary-900'
      : 'rounded-lg border border-red-700/30 bg-red-700/5 px-4 py-3 text-body-sm text-red-800';
    status.replaceChildren();
    const p = document.createElement('p');
    p.textContent = message;
    status.append(p);
    if (errors.length) {
      const ul = document.createElement('ul');
      ul.className = 'mt-1 list-inside list-disc';
      errors.forEach((e) => {
        const li = document.createElement('li');
        li.textContent = e;
        ul.append(li);
      });
      status.append(ul);
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    setLoading(true);

    const fd = new FormData(form);
    const data = {
      name: String(fd.get('name') ?? ''),
      email: String(fd.get('email') ?? ''),
      phone: `${fd.get('country')} ${fd.get('phone')}`.trim(),
      message: String(fd.get('message') ?? ''),
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (res.ok) {
        showStatus('success', json.message || 'Message sent. We’ll get back to you shortly.');
        form.reset();
        country?.dispatchEvent(new Event('change'));
        (window as Window & { trackEvent?: (name: string, props: object) => void }).trackEvent?.('contact_form_submitted', {});
      } else {
        showStatus('error', json.message || 'Your message wasn’t sent. Check your details and try again.', json.errors || []);
      }
    } catch {
      showStatus('error', 'Your message wasn’t sent because the connection failed. Check your internet and try again.');
    } finally {
      setLoading(false);
    }
  });
</script>
