---
import { Image, getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { DEMO_BOOKING_URL } from '../../data/links';
import filmPoster from '../../assets/home/film-poster.jpg';
import restaurant from '../../assets/home/restaurant-interior.jpg';
import retail from '../../assets/industries/retail.png';
import hardware from '../../assets/industries/hardware.png';
import pharmacy from '../../assets/industries/pharmacy.png';
import supermarket from '../../assets/industries/supermarket.png';

// The headline cycles through these industries; the first one is what renders without JS.
const words = [
  { word: 'Restaurant', image: restaurant },
  { word: 'Retail Shop', image: retail },
  { word: 'Hardware Store', image: hardware },
  { word: 'Pharmacy', image: pharmacy },
  { word: 'Supermarket', image: supermarket },
];

// Product film (video/home-film): first frame as the poster so playback never flashes black.
const poster = await getImage({ src: filmPoster, format: 'webp', width: 1920 });
---

<section class="wrap flex flex-col items-center gap-6 overflow-x-clip py-10 lg:gap-10 lg:py-20">
  <div class="flex w-full flex-col gap-4 text-center">
    <h1 class="font-display text-display-3 font-bold text-gray-900 md:text-[3.5rem]/[1.2] lg:text-display-1">
      <!-- Industry word + photo cycle as one unit: the next enters from below while the current exits upwards.
           Phones stack it as "Run Your" / word, without the photo (too small to read there, and it split the headline);
           from sm the photo pill joins the word on one line. -->
      <span class="inline-flex flex-col items-center sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-[0.25em] sm:gap-y-2" data-hero-line>
        <span data-hero-lead>Run Your</span>
        <span class="relative inline-flex overflow-x-visible overflow-y-clip" data-hero-slot>
          {words.map((w, i) => (
            <span
              data-hero-pair
              aria-hidden={i !== 0 ? 'true' : undefined}
              class:list={['inline-flex flex-col items-center gap-1 transition-[opacity,transform] sm:flex-row sm:gap-4 duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none', i !== 0 && 'absolute top-0 left-0']}
              style={i !== 0 ? 'transform: translateY(100%); opacity: 0' : undefined}
            >
              <span class="whitespace-nowrap italic text-primary-600">{w.word}</span>
              <span class="relative hidden h-14 w-21 shrink-0 overflow-hidden rounded-full sm:inline-block sm:h-[0.75em] sm:w-[1.125em] lg:h-20 lg:w-30">
                <Image src={w.image} alt="" widths={[240]} sizes="120px" loading="eager" class="absolute inset-0 size-full object-cover" />
              </span>
            </span>
          ))}
        </span>
      </span>
      <br />
      Smarter with SalesZote POS
    </h1>
    <p class="mx-auto max-w-300 text-body-md text-gray-900/50 lg:text-body-lg">
      Sell, track stock and see your profit from your phone, tablet or till. SalesZote brings your counter, your stock and your reports into one place.
    </p>
  </div>

  <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
    <Button href={DEMO_BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('demo_booking_clicked', { source: 'home_hero' })">Book a Demo</Button>
    <Button href="https://app.saleszote.com/register" variant="primary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('registration_started', { source: 'home_hero' })">Get Started for Free →</Button>
  </div>

  <!-- "See it in Action": the film's own opening plays as a silent 4.6 s loop (172 KB) while the block is on screen;
       a centred play button names the film and its length. Pressing anywhere plays the full film with sound in place (preload="none":
       it only downloads on play). Reduced motion: the loop never starts, the poster frame shows instead. -->
  <div class="relative aspect-video w-full overflow-hidden rounded-3xl bg-primary-50 shadow-[0_24px_48px_rgba(92,58,26,0.10)] lg:rounded-[48px]" data-hero-film>
    <video class="absolute inset-0 size-full object-cover" poster={poster.src} muted loop playsinline preload="metadata" aria-hidden="true" data-hero-teaser>
      <source src="/videos/home/saleszote-film-teaser.mp4" type="video/mp4" />
    </video>
    <video class="pointer-events-none absolute inset-0 size-full bg-black object-cover opacity-0 transition-opacity duration-300 ease-out" poster={poster.src} preload="none" playsinline aria-label="SalesZote product video: one shop's Saturday, from the first sale to the day's report" data-hero-video>
      <source src="/videos/home/saleszote-film.webm" type="video/webm" />
      <source src="/videos/home/saleszote-film.mp4" type="video/mp4" />
    </video>
    <!-- Centred play control: a large orange button with a white ring (reads on the light app screens), and the
         film's name and length in a pill under it. The whole block is the button. -->
    <button type="button" class="group absolute inset-0 flex cursor-pointer flex-col items-center justify-center gap-3 transition-opacity duration-300 ease-out focus-visible:outline-none sm:gap-5" aria-label="Play the SalesZote product video, 36 seconds" data-hero-play>
      <!-- A light tint pushes the loop back so the button and label read; it lifts on hover. -->
      <span class="absolute inset-0 bg-gray-900/15 transition-opacity duration-300 ease-out group-hover:opacity-0" aria-hidden="true"></span>
      <span class="relative flex size-16 items-center justify-center rounded-full bg-primary-600 shadow-[0_0_0_4px_#fff,0_16px_40px_rgba(23,23,23,0.28)] transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:scale-110 group-active:scale-95 group-focus-visible:outline-2 group-focus-visible:outline-offset-8 group-focus-visible:outline-primary-600 sm:size-22 sm:shadow-[0_0_0_6px_#fff,0_20px_48px_rgba(23,23,23,0.28)] lg:size-28">
        <svg viewBox="0 0 24 24" class="ml-1 size-6 sm:size-9 lg:size-11" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.54.84l11.6-7.5a1 1 0 0 0 0-1.68L8.54 3.66A1 1 0 0 0 7 4.5Z" fill="#fff" /></svg>
      </span>
      <span class="relative flex items-center gap-2 rounded-full bg-white py-1.5 pr-1.5 pl-4 shadow-[0_8px_24px_rgba(23,23,23,0.16)] sm:gap-3 sm:py-2 sm:pr-2 sm:pl-5">
        <span class="font-sans text-sm font-bold text-gray-900 sm:text-body">See it in Action</span>
        <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-ui text-xs font-semibold text-gray-900/70 sm:text-sm">0:36</span>
      </span>
    </button>
  </div>
</section>

<script>
  // Product film: play in place, then hand over to the browser's own controls.
  const film = document.querySelector<HTMLElement>('[data-hero-film]');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const play = document.querySelector<HTMLButtonElement>('[data-hero-play]');
  const teaser = document.querySelector<HTMLVideoElement>('[data-hero-teaser]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (teaser && film && !calm) {
    new IntersectionObserver(([entry]) => {
      if (film.dataset.playing === 'true') return;
      if (entry.isIntersecting) teaser.play().catch(() => {});
      else teaser.pause();
    }, { threshold: 0.25 }).observe(film);
  }
  play?.addEventListener('click', () => {
    if (!film || !video) return;
    teaser?.pause();
    film.dataset.playing = 'true';
    video.controls = true;
    video.classList.remove('opacity-0', 'pointer-events-none');
    play.classList.add('opacity-0', 'pointer-events-none');
    play.tabIndex = -1;
    video.play().catch(() => {});
    video.focus({ preventScroll: true });
    (window as unknown as { trackEvent?: (name: string, props: Record<string, string>) => void }).trackEvent?.('product_video_played', { source: 'home_hero' });
  });

  const line = document.querySelector<HTMLElement>('[data-hero-line]');
  const lead = document.querySelector<HTMLElement>('[data-hero-lead]');
  const pairs = [...document.querySelectorAll<HTMLElement>('[data-hero-pair]')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const DURATION = 500;

  if (line && lead && pairs.length > 1 && !reduceMotion) {
    let index = 0;

    setInterval(() => {
      const outgoing = pairs[index];
      index = (index + 1) % pairs.length;
      const incoming = pairs[index];
      const before = lead.getBoundingClientRect().left;

      // Current unit leaves the flow and slides up and out.
      outgoing.classList.add('absolute', 'top-0', 'left-0');
      outgoing.style.transform = 'translateY(-100%)';
      outgoing.style.opacity = '0';
      outgoing.setAttribute('aria-hidden', 'true');

      // Next unit takes its place in the flow, starting just below and sliding up.
      incoming.style.transition = 'none';
      incoming.style.transform = 'translateY(100%)';
      incoming.style.opacity = '0';
      incoming.classList.remove('absolute', 'top-0', 'left-0');
      incoming.removeAttribute('aria-hidden');
      void incoming.offsetWidth;
      incoming.style.transition = '';
      incoming.style.transform = 'translateY(0)';
      incoming.style.opacity = '1';

      // The line re-centres for the new word's width; glide it there instead of jumping.
      const shift = before - lead.getBoundingClientRect().left;
      if (shift) {
        line.style.transition = 'none';
        line.style.transform = `translateX(${shift}px)`;
        void line.offsetWidth;
        line.style.transition = `transform ${DURATION}ms ${EASE}`;
        line.style.transform = '';
      }

      // Park the outgoing unit below, ready to enter again later.
      setTimeout(() => {
        outgoing.style.transition = 'none';
        outgoing.style.transform = 'translateY(100%)';
        void outgoing.offsetWidth;
        outgoing.style.transition = '';
      }, DURATION);
    }, 3000);
  }
</script>
