---
import { Image } from 'astro:assets';
import Accordion from '../ui/Accordion.astro';
import restaurant from '../../assets/home/restaurant-interior.jpg';
import phone from '../../assets/home/phone-add-to-cart.png';

const features = [
  { title: 'Point of Sale', body: 'Ring up sales in seconds on your phone, tablet or register. Accept cash, M-Pesa and card, apply discounts, and print or share receipts.' },
  { title: 'Smart Inventory Management', body: 'Track stock in real time across branches and warehouses, set re-order levels, run stock counts and record wastage.' },
  { title: 'Reports and Insights', body: 'See your sales, best-sellers, stock value and profit at a glance, so you know exactly how your business is doing.' },
  { title: 'Payment Integration', body: 'Record M-Pesa, cash, card and custom payment methods against every sale, and reconcile them at the end of the day.' },
  { title: 'Expense and Supplier Tracking', body: 'Log daily expenses, manage suppliers, raise purchase orders and record returns, all in one place.' },
];
---

<!--
  Backgrounds are full-bleed (grey on the left half of the screen, photo on the right half) while the
  text and phone stay inside the page's content width. Both split at the screen's centre, so they line up.
  On phones the photo + phone shot moves inside the accordion, under the open answer (Figma mobile frame).
  The photo's sizes is the width object-cover actually draws it at (3:2 photo in a ~944px-tall column ≈ 1416px),
  not the column width, or the browser picks a file that's too small.
-->
<section id="features" class="relative bg-gray-100">
  <div class="wrap grid lg:min-h-236 lg:grid-cols-2">
    <div class="flex flex-col justify-center gap-6 py-10 lg:py-20 lg:pr-20">
      <div class="flex flex-col gap-2 text-gray-900">
        <h2 class="font-display text-display-3 lg:text-display-2">Features That Power Your Business</h2>
        <p class="text-body-md text-gray-900/50">SalesZote is packed with smart, practical tools to help you sell faster, manage inventory easily and stay in control of your business every day.</p>
      </div>
      <Accordion name="features" items={features}>
        <div slot="media" class="relative flex h-163.5 justify-center overflow-hidden pt-10">
          <Image src={restaurant} alt="" widths={[720, 1440]} sizes="980px" class="absolute inset-0 size-full object-cover" />
          <Image src={phone} alt="SalesZote POS screen adding beef and accompaniments to a restaurant order" widths={[265, 530, 795]} sizes="265px" class="relative h-143.5 w-auto rounded-[28px] border-4 border-white" />
        </div>
      </Accordion>
    </div>

    <div class="hidden items-center justify-center lg:flex lg:py-20">
      <Image src={restaurant} alt="" widths={[720, 1440, 2160, 3000]} sizes="1416px" class="absolute inset-y-0 left-1/2 h-full w-1/2 object-cover" />
      <Image src={phone} alt="SalesZote POS screen adding beef and accompaniments to a restaurant order" widths={[362, 724]} sizes="362px" class="relative h-196 w-auto rounded-[38px] border-4 border-white" data-features-phone />
    </div>
  </div>
</section>
