---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Feature = { title: string; desc: string; image: ImageMetadata; position?: 'top' };
type Props = { features: Feature[]; label: string };

const { features, label } = Astro.props;
---

<!--
  Scroll-swap: the features are layered in the same grid cell inside a pinned (sticky) block that fills the
  screen below the sticky site header (--header-h is set by the navbar). The section is one screen tall per
  feature, so scrolling swaps which one is visible. Phones stack photo over text; from lg they sit side by side.
  svh keeps the pinned block steady while mobile browser bars show and hide.
-->
<section aria-label={label} style={`--steps: ${features.length}`} class="h-[calc(var(--steps)*100svh)]" data-scroll-features>
  <div class="sticky top-(--header-h,0px) flex h-[calc(100svh-var(--header-h,0px))] items-center overflow-hidden" data-scroll-pin>
    <ol class="wrap grid">
      {features.map((f, i) => (
        <li
          data-feature
          data-active={i === 0 ? 'true' : 'false'}
          class="group col-start-1 row-start-1 flex flex-col gap-10 transition-opacity duration-500 ease-out motion-reduce:transition-none data-[active=false]:pointer-events-none data-[active=false]:opacity-0 lg:flex-row lg:items-center"
        >
          <!-- Same frame as the POS page's tablet: translucent bezel, rounded photo inside (inner radius = outer - padding). -->
          <div class="w-full rounded-2xl bg-black/20 p-1.5 shadow-[0_24px_48px_rgba(0,0,0,0.08)] sm:rounded-3xl sm:p-2 lg:w-auto lg:min-w-0 lg:flex-1 lg:rounded-[32px] lg:p-3">
            <Image src={f.image} alt="" widths={[600, 1000, 1416]} sizes="(min-width: 1024px) 684px, calc(100vw - 3.75rem)" class:list={['aspect-[3/2] w-full rounded-[10px] bg-gray-100 object-cover sm:rounded-2xl lg:rounded-[20px]', f.position === 'top' && 'object-top']} />
          </div>
          <div class="flex max-w-112.5 flex-col gap-2 text-gray-900 transition-transform duration-500 ease-out group-data-[active=false]:translate-y-4 motion-reduce:transition-none lg:flex-1">
            <h2 class="font-display text-display-3 lg:text-display-2">{f.title}</h2>
            <p class="text-body-md opacity-50 lg:text-body-lg">{f.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scroll-features]').forEach((section) => {
    const pin = section.querySelector<HTMLElement>('[data-scroll-pin]');
    const items = section.querySelectorAll<HTMLElement>('[data-feature]');

    function update() {
      if (!pin) return;
      const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 0;
      const scrollable = section.offsetHeight - pin.offsetHeight;
      if (scrollable <= 0) return;
      const progress = Math.min(Math.max((headerH - section.getBoundingClientRect().top) / scrollable, 0), 0.9999);
      const index = Math.floor(progress * items.length);
      items.forEach((el, i) => (el.dataset.active = String(i === index)));
    }

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  });
</script>
