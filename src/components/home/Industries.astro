---
import { industries } from '../../data/industries';
---
<section id="industries" class="max-w-8xl mx-auto px-8 xl:px-30 py-10 lg:py-20">
    <div class="inline-flex flex-col items-center w-full gap-y-6">
        <h2 class="text-center justify-start text-black text-2xl sm:text-4xl font-bold leading-loose sm:leading-10">Who Is SalesZote For?</h2>
        <div class="max-w-[794px] text-center justify-start text-black text-base font-medium leading-snug">
            SalesZote is built to serve a wide range of businesses. Whether you're just starting out or managing multiple branches,
            SalesZote gives you the tools to sell, manage and grow with confidence.
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 mt-7">
        {industries.map((industry) => (
            <a
                href={`/industries/${industry.slug}`}
                class="industry group relative transition-transform duration-200 ease-out hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-300"
                style={`background-image:linear-gradient(180deg,rgba(0,0,0,0.00) 0%,rgba(0,0,0,0.80) 100%),url('${industry.image}');`}
            >
                <h3 class="justify-start text-white text-base lg:text-xl font-bold leading-snug lg:leading-7">{industry.cardTitle}</h3>
                <p class="self-stretch justify-start text-zinc-100 text-sm sm:text-base font-medium leading-snug">{industry.cardBlurb}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-primary-300 text-sm font-bold">
                    Learn more
                    <svg class="w-4 h-4 transition-transform duration-200 ease-out group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
        ))}
    </div>
</section>
