---
---
<footer class="bg-[#090727]">
    <div class="max-w-8xl mx-auto px-8 xl:px-30 py-10 lg:py-20">
        <div class="grid grid-cols-2 lg:grid-cols-6 gap-x-5 gap-y-10 lg:gap-y-5">
            <div class="col-span-2 lg:col-span-2 flex flex-col justify-start items-start gap-y-4">
                <img class="h-13.5 -ml-2.5" src="/images/logo/logo_light.svg" alt="SalesZote Logo" />

                <div class="max-w-96 justify-center text-white text-sm font-medium leading-tight">
                    Sales Zote is a powerful and easy-to-use retail POS solution designed to simplify your sales, inventory, and customer management.
                </div>

                <div class="flex">
                    <a href="https://www.instagram.com/saleszote" target="_blank" rel="noopener noreferrer" onclick="trackEvent('social_link_clicked', { platform: 'instagram' })" class="w-8 h-8 bg-white flex justify-center items-center rounded-full mr-3">
                        <img src="/images/icons/instagram.svg" alt="SalesZote Instagram" />
                    </a>

                    <a href="https://www.linkedin.com/company/saleszote" target="_blank" rel="noopener noreferrer" onclick="trackEvent('social_link_clicked', { platform: 'linkedin' })" class="w-8 h-8 bg-white flex justify-center items-center rounded-full mr-3">
                        <img src="/images/icons/linkedin.svg" alt="SalesZote LinkedIn" />
                    </a>

                    <a href="https://web.facebook.com/saleszote" target="_blank" rel="noopener noreferrer" onclick="trackEvent('social_link_clicked', { platform: 'facebook' })" class="w-8 h-8 bg-white flex justify-center items-center rounded-full">
                        <img src="/images/icons/facebook.svg" alt="SalesZote Facebook" />
                    </a>
                </div>
            </div>

            <div>
                <h6 class="justify-center text-amber-500 text-sm font-bold leading-tight">Solutions</h6>

                <div class="self-stretch inline-flex flex-col justify-start items-start gap-3.5 mt-6">
                    <a href="/pos-system-kenya" class="justify-center text-white text-sm font-medium leading-tight hover:text-amber-400" style="transition: color 150ms ease;">POS System</a>
                    <a href="/inventory-management-kenya" class="justify-center text-white text-sm font-medium leading-tight hover:text-amber-400" style="transition: color 150ms ease;">Inventory Management</a>
                    <a href="/pricing" class="justify-center text-white text-sm font-medium leading-tight hover:text-amber-400" style="transition: color 150ms ease;">Pricing</a>
                    <a href="/#industries" class="justify-center text-white text-sm font-medium leading-tight hover:text-amber-400" style="transition: color 150ms ease;">Industries</a>
                </div>
            </div>

            <div>
                <h6 class="justify-center text-amber-500 text-sm font-bold leading-tight">Quick Links</h6>

                <div class="self-stretch inline-flex flex-col justify-start items-start gap-3.5 mt-6">
                    <a href="https://app.saleszote.com/register" onclick="trackEvent('registration_started', { source: 'footer' })" class="self-stretch justify-center text-white text-sm font-medium leading-tight">Create Account</a>
                    <a href="https://app.saleszote.com/login" class="justify-center text-white text-sm font-medium leading-tight">Sign In</a>
                </div>
            </div>

            <div>
                <h6 class="justify-center text-amber-500 text-sm font-bold leading-tight">Get Started</h6>

                <div class="self-stretch inline-flex flex-col justify-start items-start gap-3.5 mt-6">
                    <a href="/contact" class="justify-center text-white text-sm font-medium leading-tight">Request a Feature</a>
                    <a href="/contact" class="justify-center text-white text-sm font-medium leading-tight">Contact Us</a>
                </div>
            </div>

            <div>
                <h6 class="justify-center text-amber-500 text-sm font-bold leading-tight">Mobile App</h6>

                <div class="self-stretch inline-flex flex-col justify-start items-start gap-3 mt-6">
                    <a href="https://apps.apple.com/us/app/sales-zote/id6761330158" target="_blank" rel="noopener noreferrer"
                       onclick="trackEvent('app_download_clicked', { platform: 'ios', source: 'footer' });"
                       class="block rounded-lg opacity-90 hover:opacity-100 active:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#090727]"
                       style="transition: opacity 150ms ease;">
                        <img src="/images/app-store-badge.svg" alt="Download SalesZote on the App Store" class="h-11 w-37 object-contain object-left" />
                    </a>
                    <a href="https://play.google.com/store/apps/details?id=com.saleszote.app" target="_blank" rel="noopener noreferrer"
                       onclick="trackEvent('app_download_clicked', { platform: 'android', source: 'footer' });"
                       class="block rounded-lg opacity-90 hover:opacity-100 active:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#090727]"
                       style="transition: opacity 150ms ease;">
                        <img src="/images/google-play-badge.svg" alt="Get SalesZote on Google Play" class="h-11 w-37 object-contain object-left" />
                    </a>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-center pt-6 border-t border-white mt-9 gap-x-3.5">
            <div class="justify-start text-white text-xs font-medium">© Copyright 2025. SalesZote LTD</div>
            <div class="w-1.25 h-1.25 bg-neutral-400 rounded-sm"></div>
            <a href="/privacy-policy" class="justify-start text-white text-xs font-medium hover:underline">
                Privacy Policy
            </a>
        </div>
    </div>
</footer>
