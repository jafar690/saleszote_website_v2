---
interface Props {
  title: string;
  text: string;
  ctaLabel?: string;
  ctaHref?: string;
  source?: string;
}

const {
  title,
  text,
  ctaLabel = 'Get Started For Free',
  ctaHref = 'https://app.saleszote.com/register',
  source = 'landing_cta',
} = Astro.props;
---
<section class="max-w-8xl mx-auto px-8 xl:px-30 bg-[#52154E] bg-[url('/images/backgrounds/bg3.svg')] bg-cover bg-no-repeat">
    <div class="flex flex-col items-center py-16 lg:py-20 text-center">
        <h2 class="text-white text-2xl sm:text-4xl font-bold leading-loose sm:leading-10 max-w-3xl">{title}</h2>
        <p class="text-white text-base font-medium leading-snug mt-4 max-w-2xl">{text}</p>
        <div class="mt-9">
            <a
                href={ctaHref}
                onclick={`trackEvent('registration_started', { source: '${source}' })`}
                class="px-8 py-3 rounded-lg inline-flex bg-primary-500 border-1 border-primary-500 text-white text-base font-medium font-main leading-snug transition-transform duration-200 ease-out hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-300"
            >
                {ctaLabel}
            </a>
        </div>
    </div>
</section>
