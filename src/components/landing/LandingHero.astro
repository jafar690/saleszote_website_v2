---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  sub: string;
  breadcrumbs?: Crumb[];
  source?: string;
}

const { eyebrow, title, sub, breadcrumbs = [], source = 'landing_hero' } = Astro.props;
---
<section class="bg-neutral-50 pt-10 lg:pt-16 pb-12 lg:pb-20 px-8 xl:px-30">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        {breadcrumbs.length > 0 && (
            <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex flex-wrap items-center justify-center gap-x-2 text-sm font-medium text-neutral-500">
                    {breadcrumbs.map((crumb, i) => (
                        <li class="flex items-center gap-x-2">
                            {crumb.href ? (
                                <a href={crumb.href} class="hover:text-primary-500 transition-colors">{crumb.label}</a>
                            ) : (
                                <span class="text-neutral-700" aria-current="page">{crumb.label}</span>
                            )}
                            {i < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
                        </li>
                    ))}
                </ol>
            </nav>
        )}

        {eyebrow && (
            <span class="inline-flex items-center rounded-full bg-primary-100 text-primary-700 text-xs font-bold uppercase tracking-wide px-3 py-1 mb-5">{eyebrow}</span>
        )}

        <h1 class="text-black text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">{title}</h1>
        <p class="max-w-2xl text-neutral-600 text-base lg:text-lg font-medium leading-relaxed mt-6">{sub}</p>

        <div class="mt-9 flex flex-col sm:flex-row items-center gap-4">
            <a
                href="https://app.saleszote.com/register"
                onclick={`trackEvent('registration_started', { source: '${source}' })`}
                class="px-8 py-3 rounded-lg inline-flex bg-primary-500 border-1 border-primary-500 text-white text-base font-medium font-main leading-snug transition-transform duration-200 ease-out hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-300"
            >
                Get Started For Free
            </a>
            <a
                href="/pricing"
                class="px-8 py-3 rounded-lg inline-flex border-1 border-neutral-300 text-black text-base font-medium font-main leading-snug transition-colors duration-200 hover:border-primary-500 hover:text-primary-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary-300"
            >
                See Pricing
            </a>
        </div>
        <p class="text-neutral-500 text-sm font-medium mt-4">Free for 14 days · No credit card required</p>
    </div>
</section>
