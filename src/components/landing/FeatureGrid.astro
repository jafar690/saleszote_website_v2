---
interface Feature {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  heading: string;
  intro?: string;
  features: Feature[];
}

const { heading, intro, features } = Astro.props;
---
<section class="max-w-8xl mx-auto px-8 xl:px-30 py-10 lg:py-20">
    <div class="inline-flex flex-col items-center w-full">
        <h2 class="text-center text-black text-2xl sm:text-4xl font-bold font-main leading-10 mb-4">{heading}</h2>
        {intro && (
            <p class="max-w-190 text-center text-black text-base font-medium font-main leading-[140%]">{intro}</p>
        )}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-7">
        {features.map((feature) => (
            <div class="flex flex-col gap-4 p-6 rounded-2xl bg-white outline outline-1 outline-offset-[-1px] outline-neutral-200">
                <div class="bg-white w-12 h-12 flex items-center justify-center rounded-xl icon-shadow">
                    <img src={`/images/icons/${feature.icon}.svg`} alt="" aria-hidden="true">
                </div>
                <h3 class="text-black text-lg sm:text-2xl font-bold font-main leading-[140%]">{feature.title}</h3>
                <p class="text-neutral-600 text-base font-medium font-main leading-[140%]">{feature.desc}</p>
            </div>
        ))}
    </div>
</section>
