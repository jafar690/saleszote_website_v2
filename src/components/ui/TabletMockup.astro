---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Tablet from the Figma solution-page heroes: translucent bezel (14px, 36px corners) around a 22px-rounded
// screen, 1034px wide at most. The bezel and corners scale down on small screens so it doesn't look chunky.
// screen: a 2x export of the Figma screen frame (2012 × 1509).
type Props = { screen: ImageMetadata; alt: string; class?: string };

const { screen, alt, class: className } = Astro.props;
---

<div class:list={['w-full max-w-[1033.948px] rounded-2xl bg-black/20 p-1.5 shadow-[0_24px_48px_rgba(0,0,0,0.08)] sm:rounded-3xl sm:p-2.5 lg:rounded-[36px] lg:p-3.5', className]}>
  <Image src={screen} alt={alt} widths={[600, 1006, 1500, 2012]} sizes="(min-width: 1082px) 1006px, calc(100vw - 4rem)" loading="eager" class="h-auto w-full rounded-[10px] bg-white sm:rounded-2xl lg:rounded-[22px]" />
</div>
