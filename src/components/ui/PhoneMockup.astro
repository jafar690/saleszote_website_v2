---
// iPhone 12 Pro frame from Figma (pre-cropped from its sprite at full resolution); the screen is clipped by the device mask.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../../assets/home/iphone-frame.png';

type Props = { screen: ImageMetadata; alt: string; class?: string };

const { screen, alt, class: className } = Astro.props;
---

<div class:list={['h-[689.865px] w-[333.435px]', className ?? 'relative']}>
  <Image src={frame} alt="" widths={[330, 660, 689]} sizes="330px" class="pointer-events-none absolute top-[1.53%] left-[0.57%] h-[96.94%] w-[99%] max-w-none" />
  <div class="absolute inset-[3.54%_5.32%_3.54%_5.6%] mask-[url('/images/new/iphone-screen-mask.svg')] mask-size-[100%_100%] mask-no-repeat">
    <Image src={screen} alt={alt} widths={[297, 595]} sizes="297px" class="size-full" />
  </div>
</div>
