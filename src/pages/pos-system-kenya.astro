---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import TabletMockup from '../components/ui/TabletMockup.astro';
import VideoFeatures from '../components/sections/VideoFeatures.astro';
import Steps from '../components/sections/Steps.astro';
import WhoIsItFor from '../components/sections/WhoIsItFor.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import QuickSetupCta from '../components/sections/QuickSetupCta.astro';
import { DEMO_BOOKING_URL } from '../data/links';
import heroScreen from '../assets/pos/hero-tablet-cart.png';
import posterAddToCart from '../assets/pos/posters/add-to-cart.png';
import posterCheckout from '../assets/pos/posters/checkout.png';
import posterStock from '../assets/pos/posters/stock-decrease.png';
import posterStaff from '../assets/pos/posters/employee-login.png';
import posterReport from '../assets/pos/posters/sales-report.png';
import posterDevices from '../assets/pos/posters/multi-platform.png';

const features = [
  { title: 'Fast checkout', body: 'Scan or search products, add to the sale, and take payment in a few taps — even when there is a queue at the counter.', video: 'pos/add-to-cart', poster: posterAddToCart },
  { title: 'M-Pesa, cash, card and more', body: 'Record M-Pesa, cash, card or any payment method you add, all in one place, so reconciling your day takes minutes.', video: 'pos/checkout', poster: posterCheckout },
  { title: 'Stock updates as you sell', body: 'Every sale updates your inventory instantly, so what you see on screen matches what is on the shelf.', video: 'pos/stock-decrease', poster: posterStock },
  { title: 'Staff accounts', body: 'Give each team member their own login and see who sold what, across one counter or several tills.', video: 'pos/employee-login', poster: posterStaff },
  { title: 'Daily sales reports', body: 'See takings, best-sellers, and slow movers by day, week, or month so you always know how the shop is doing.', video: 'pos/sales-report', poster: posterReport },
  { title: 'Works on any device', body: 'Run SalesZote on a phone, tablet, or computer. Your data is in the cloud, so you can check on the shop from anywhere.', video: 'pos/multi-platform', poster: posterDevices, landscape: true },
];

const steps = [
  { title: 'Create your free account', body: 'Sign up in minutes — no credit card and no setup fee to get started.', icon: '/images/new/steps-account.svg' },
  { title: 'Add your products', body: 'Enter your items and prices, or import them. Set reorder levels so you never run out.', icon: '/images/new/steps-products.svg' },
  { title: 'Start selling', body: 'Ring up sales, take M-Pesa or cash, and watch your stock and reports update in real time.', icon: '/images/new/steps-sell.svg' },
];

const faqs = [
  { question: 'What is a POS system?', answer: '<p>A POS (point of sale) system is the software and screen you use to ring up sales, take payment, and record every transaction. SalesZote also tracks your stock and gives you reports, so it is a POS and inventory system in one.</p>' },
  { question: 'Does SalesZote work with M-Pesa?', answer: '<p>Yes. SalesZote lets you record M-Pesa, cash and card payments together, and you can add any other payment method you use, such as Airtel Money or bank transfer, so your daily totals always add up.</p>' },
  { question: 'Do I need special hardware to use it?', answer: '<p>No. SalesZote runs on any phone, tablet, or computer you already own. You can add a barcode scanner or receipt printer if you want, but you can start with just a phone.</p>' },
  { question: 'Can more than one person use it at the same time?', answer: '<p>Yes. You can add staff accounts so several people can serve customers at once, and you can see who made each sale.</p>' },
  { question: 'How much does a POS system cost in Kenya?', answer: '<p>SalesZote plans start from KES 1,000 per month, and you can try it free for 7 days with no credit card. See the <a href="/pricing">pricing page</a> for full details.</p>' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://saleszote.com/' },
      { '@type': 'ListItem', position: 2, name: 'POS System', item: 'https://saleszote.com/pos-system-kenya' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SalesZote POS System',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, iOS, Android',
    description: 'Cloud POS system for shops and wholesalers in Kenya, with M-Pesa payments, fast checkout, and real-time stock tracking.',
    url: 'https://saleszote.com/pos-system-kenya',
    offers: { '@type': 'Offer', price: '1000', priceCurrency: 'KES', description: 'Plans from KES 1,000/month. Free 7-day trial.' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer.replace(/<[^>]+>/g, '').trim() },
    })),
  },
];
---
<Layout
  title="POS System in Kenya | M-Pesa Point of Sale Software | SalesZote"
  description="SalesZote is a cloud POS system for shops and wholesalers in Kenya. Sell with M-Pesa, cash, or card, track stock in real time, and manage staff from any device. Free for 7 days."
  jsonLd={jsonLd}
  navbarBg="bg-primary-50"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Solutions' },
    { label: 'POS System' },
  ]}
>
  <section class="bg-primary-50">
  <div class="wrap flex flex-col items-center gap-10 py-10 lg:py-20">
    <div class="flex max-w-200 flex-col gap-2 text-center text-gray-900">
      <h1 class="font-display text-display-3 font-bold lg:text-display-2">A POS System Built for Kenyan Businesses</h1>
      <p class="text-body-md text-gray-900/50">Sell faster with M-Pesa, cash &amp; card, keep your stock accurate and see how your shop is doing — all from your phone or the counter.</p>
    </div>
    <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
      <Button href={DEMO_BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('demo_booking_clicked', { source: 'pos_hero' })">Book a Demo</Button>
      <Button href="https://app.saleszote.com/register" variant="primary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('registration_started', { source: 'pos_hero' })">Get Started for Free →</Button>
    </div>
    <TabletMockup screen={heroScreen} alt="The SalesZote POS on a tablet: product grid on the left and the cart with totals and Complete Sale on the right" />
  </div>
  </section>

  <VideoFeatures
    title="Everything you need at the counter"
    intro="Everything that happens at the till, from scanning an item to taking payment and counting up the day."
    features={features}
  />

  <Steps title="Up and running in three steps" subtitle="No setup fee, no new hardware and no training." steps={steps} />

  <WhoIsItFor title="A POS for your kind of business" subtitle="See how SalesZote works for shops like yours." />

  <FaqSection faqs={faqs} />

  <QuickSetupCta source="pos_cta" />
</Layout>
