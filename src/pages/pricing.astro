---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import QuickSetupCta from '../components/sections/QuickSetupCta.astro';
import trialPhone from '../assets/home/device-mobile.png';
import pricing from '../data/pricing.json';

const { plans, faqs, comparison_table } = pricing;

function formatPrice(price: number) {
  return price.toLocaleString('en-KE');
}

const planIds = ['starter', 'growth', 'business', 'enterprise'] as const;

type CellValue = boolean | string;

const processedTable = comparison_table.map(section => ({
  category: section.category,
  rows: section.rows.map(row => ({
    label: row.label,
    cells: planIds.map(id => (row as Record<string, CellValue>)[id]),
  })),
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'SalesZote POS & Inventory Management System',
    description:
      'Cloud POS and inventory management software for retailers and wholesalers in Kenya, with M-Pesa payments and real-time stock tracking.',
    brand: { '@type': 'Brand', name: 'SalesZote' },
    offers: plans
      .filter((plan) => !plan.is_custom)
      .map((plan) => ({
        '@type': 'Offer',
        name: `${plan.name} plan`,
        price: String(plan.monthly_price),
        priceCurrency: 'KES',
        url: plan.cta_url,
        availability: 'https://schema.org/InStock',
      })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];

const usage = comparison_table.find((s) => s.category === 'Usage')!.rows as Record<string, string>[];
const nouns: Record<string, [string, string]> = {
  Users: ['user', 'users'],
  Branches: ['branch', 'branches'],
  'Inventory Locations': ['inventory location', 'inventory locations'],
  Terminals: ['terminal', 'terminals'],
  Products: ['product', 'products'],
};

function limitLine(row: Record<string, string>, planId: string) {
  const value = row[planId];
  const [one, many] = nouns[row.label];
  if (value === 'Custom') return `Custom ${many}`;
  if (value === 'Unlimited') return `Unlimited ${many}`;
  return `${value} ${value === '1' ? one : many}`;
}

const cards = plans.map((plan) => ({
  ...plan,
  limits: usage.map((row) => ({ text: limitLine(row, plan.id), hint: row.label === 'Inventory Locations' })),
}));
---

<Layout
  title="POS & Inventory System Pricing in Kenya | SalesZote"
  description="Simple, transparent SalesZote pricing in KES for shops and wholesalers in Kenya. Start free for 7 days — no credit card required. Plans from KES 1,000/month."
  jsonLd={jsonLd}
>
  <section class="wrap flex flex-col items-center gap-6 pt-10 pb-6 lg:gap-10 lg:pt-20 lg:pb-10">
    <div class="flex flex-col gap-4 text-center text-gray-900">
      <h1 class="font-display text-display-3 font-bold lg:text-display-2">Transparent Pricing.<br />No Surprises.</h1>
      <p class="text-body-md text-gray-900/50">Pick the plan that fits your business. Prices are in KES for every country. Start free for 7 days — no credit card needed.</p>
    </div>

    <div class="relative flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-cta-lg text-gray-900 sm:gap-x-4">
      <p>Billed Monthly</p>
      <button id="billing-toggle" type="button" role="switch" aria-checked="false" class="group relative h-5 w-8 shrink-0 rounded-full bg-gray-100 shadow-[inset_0_2px_4px_rgba(0,0,0,0.06)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 aria-checked:bg-primary-600">
        <span class="absolute top-0.75 left-0.75 size-3.5 rounded-full bg-gray-400 shadow-[0_0_3px_rgba(0,0,0,0.1)] transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-active:scale-90 group-aria-checked:translate-x-3 group-aria-checked:bg-white"></span>
      </button>
      <span class="flex items-center gap-1">
        <label for="billing-toggle" class="cursor-pointer">Billed Yearly</label>
        <span class="text-cta whitespace-nowrap text-primary-600 sm:hidden">Save 20%</span>
      </span>
      <div aria-hidden="true" class="pointer-events-none absolute top-2.75 left-full hidden items-end gap-1 sm:flex">
        <img src="/images/new/pricing/save-squiggle.svg" alt="" width="82" height="41" class="h-10.25 w-20.5 max-w-none" />
        <p class="text-cta whitespace-nowrap text-primary-600">Save 20%</p>
      </div>
    </div>

    <div class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((plan) => (
        <div class:list={[
          'relative flex flex-col gap-4 rounded-2xl p-4',
          plan.is_popular ? 'border-3 border-primary-600 bg-white' : 'border border-gray-200 bg-gray-50',
        ]}>
          {plan.is_popular && (
            <p class="absolute -top-[15px] left-1/2 flex w-37.5 -translate-x-1/2 items-center justify-center gap-1 rounded-3xl bg-primary-600 px-2 py-1 text-cta text-white">
              <img src="/images/new/pricing/star.svg" alt="" width="16" height="16" />Most popular
            </p>
          )}
          <div class="flex flex-col gap-2 text-gray-900">
            <h2 class="text-body-lg font-bold">{plan.name}</h2>
            <p class="text-body-sm opacity-50">{plan.tagline}</p>
          </div>
          <div class="text-gray-900">
            {plan.is_custom ? (
              <>
                <p class="text-heading-1">Custom</p>
                <p class="text-body-sm opacity-50">Pricing built around your business.</p>
              </>
            ) : (
              <>
                <p class="text-heading-1">
                  KES <span data-monthly={formatPrice(plan.monthly_price!)} data-yearly={formatPrice(plan.annual_monthly_price!)}>{formatPrice(plan.monthly_price!)}</span>
                </p>
                <p class="text-body-sm opacity-50" data-billing-note>/month billed monthly.</p>
              </>
            )}
          </div>
          <ul class="flex flex-1 flex-col gap-3">
            {plan.limits.map((l) => (
              <li class="flex items-center gap-2 text-body text-gray-900">
                <img src="/images/new/pricing/check-circle.svg" alt="" width="16" height="16" class="shrink-0" />
                {l.text}
                {l.hint && (
                  <span class="group/tip relative inline-flex">
                    <button type="button" aria-describedby={`tip-${plan.id}`} aria-label="What is an inventory location?" class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                      <img src="/images/new/pricing/help-circle.svg" alt="" width="12" height="12" />
                    </button>
                    <span id={`tip-${plan.id}`} role="tooltip" class="pointer-events-none absolute right-0 bottom-full z-10 mb-2 w-48 sm:right-auto sm:left-1/2 sm:-translate-x-1/2 rounded-lg bg-gray-900 px-3 py-2 text-body-sm text-white opacity-0 transition-opacity duration-200 group-focus-within/tip:opacity-100 group-hover/tip:opacity-100">A store, warehouse or store room where you keep stock.</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
          <Button
            href={plan.is_custom ? '/contact' : plan.cta_url}
            variant={plan.is_custom ? 'dark' : plan.is_popular ? 'primary' : 'outline'}
            class="w-full"
            onclick={plan.is_custom ? undefined : `trackEvent('registration_started', { source: 'pricing_${plan.id}' })`}
          >{plan.is_custom ? 'Talk to Sales' : 'Start Free Trial'}</Button>
        </div>
      ))}
    </div>

    <div class="flex w-full max-w-125 overflow-hidden rounded-3xl bg-secondary-900 pt-4">
      <Image src={trialPhone} alt="" widths={[134, 268, 402]} sizes="134px" class="h-50 w-[133.33px] shrink-0 object-cover" />
      <div class="flex flex-col justify-center gap-2 px-6 text-white">
        <p class="text-body font-bold lg:text-body-md">7-day trial.<br />No credit card required.</p>
        <p class="text-body-sm opacity-70 lg:text-body">Try any plan free for 7 days. If it's not right for your business, simply walk away, no questions asked.</p>
      </div>
    </div>
  </section>

  <section class="wrap pb-10 lg:pb-20">
    <div class="flex flex-col gap-2 text-center text-gray-900">
      <h2 class="font-display text-display-3 lg:text-display-2">Compare Plans</h2>
      <p class="text-body-md text-gray-900/50">Everything you need to make the right choice.</p>
    </div>
    <div class="mt-6 overflow-x-auto lg:mt-10">
      <table class="w-full min-w-182.5 table-fixed border-collapse text-body-sm text-gray-900 lg:min-w-200 lg:text-body">
        <thead>
          <tr class="border-b border-gray-200">
            <th scope="col" class="w-62.5 p-3 text-left font-bold lg:w-100">Features</th>
            {plans.map((p) => <th scope="col" class="p-3 text-center font-bold">{p.name}</th>)}
          </tr>
        </thead>
        {processedTable.map((section) => (
          <tbody>
            <tr class="border-b border-gray-200 bg-gray-100">
              <th scope="colgroup" colspan={5} class="p-3 text-left font-bold opacity-50">{section.category}</th>
            </tr>
            {section.rows.map((row) => (
              <tr class="border-b border-gray-200">
                <th scope="row" class="p-3 text-left font-bold">
                  <span class="inline-flex items-center gap-2">{row.label}{row.label === 'Inventory Locations' && <img src="/images/new/pricing/help-circle.svg" alt="" width="12" height="12" title="A store, warehouse or store room where you keep stock." />}</span>
                </th>
                {row.cells.map((cell) => (
                  <td class="p-3 text-center">
                    {typeof cell === 'string' ? cell : cell ? (
                      <span class="inline-flex rounded-3xl bg-primary-600 p-1"><img src="/images/new/pricing/check.svg" alt="Included" width="14" height="14" class="size-3 lg:size-3.5" /></span>
                    ) : (
                      <span class="inline-flex rounded-3xl border border-gray-400 p-0.75 lg:p-1"><img src="/images/new/pricing/x.svg" alt="Not included" width="14" height="14" class="size-3 lg:size-3.5" /></span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  <FaqSection faqs={faqs} />
  <QuickSetupCta source="pricing_cta" title="Ready to grow your business?" body="Join businesses in Kenya, Uganda, South Sudan and the Maldives already running smarter with SalesZote." />
</Layout>

<script>
  const toggle = document.getElementById('billing-toggle');
  toggle?.addEventListener('click', () => {
    const yearly = toggle.getAttribute('aria-checked') !== 'true';
    toggle.setAttribute('aria-checked', String(yearly));
    document.querySelectorAll<HTMLElement>('[data-monthly]').forEach((el) => {
      el.textContent = (yearly ? el.dataset.yearly : el.dataset.monthly) ?? '';
    });
    document.querySelectorAll<HTMLElement>('[data-billing-note]').forEach((el) => {
      el.textContent = yearly ? '/month billed yearly.' : '/month billed monthly.';
    });
  });
</script>
