---
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import ScrollFeatures from '../../components/sections/ScrollFeatures.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import QuickSetupCta from '../../components/sections/QuickSetupCta.astro';
import { industries } from '../../data/industries';
import { DEMO_BOOKING_URL } from '../../data/links';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const url = `https://saleszote.com/industries/${industry.slug}`;

function stripHtml(html: string) {
  return html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://saleszote.com/' },
      { '@type': 'ListItem', position: 2, name: industry.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `SalesZote POS & Inventory for ${industry.name}`,
    description: industry.metaDescription,
    brand: { '@type': 'Brand', name: 'SalesZote' },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KES',
      availability: 'https://schema.org/InStock',
      description: 'Free 7-day trial, no credit card required.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: industry.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(faq.answer) },
    })),
  },
];

// Feature photos from Figma: src/assets/industries/features/<slug>/1.jpg … 4.jpg, in the same order as industry.features.
const featurePhotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/industries/features/*/*.jpg', { eager: true });
// Photos the design crops from the top rather than the centre.
const topAnchored: Record<string, number[]> = { 'electronics-shops': [2, 3], 'mini-supermarkets': [2] };

const features = industry.features.map((f, i) => {
  const photo = featurePhotos[`../../assets/industries/features/${industry.slug}/${i + 1}.jpg`];
  if (!photo) throw new Error(`Missing feature photo ${i + 1} for ${industry.slug}`);
  return { title: f.title, desc: f.desc, image: photo.default, position: topAnchored[industry.slug]?.includes(i + 1) ? ('top' as const) : undefined };
});
---

<Layout
  title={industry.metaTitle}
  description={industry.metaDescription}
  jsonLd={jsonLd}
  navbarBg="bg-primary-50"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Industries', href: '/#industries' },
    { label: industry.name },
  ]}
>
  <section class="bg-primary-50 py-10 lg:py-20">
    <div class="wrap flex flex-col items-center gap-6 lg:gap-10">
      <div class="flex max-w-200 flex-col gap-2 text-center text-gray-900">
        <h1 class="font-display text-display-3 font-bold lg:text-display-2">{industry.h1}</h1>
        <p class="text-body-md text-gray-900/50">{industry.heroSub}</p>
      </div>
      <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
        <Button href={DEMO_BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary" size="lg" class="w-full sm:w-57.5" onclick={`trackEvent('demo_booking_clicked', { source: 'industry_${industry.slug}_hero' })`}>Book a Demo</Button>
        <Button href="https://app.saleszote.com/register" variant="primary" size="lg" class="w-full sm:w-57.5" onclick={`trackEvent('registration_started', { source: 'industry_${industry.slug}_hero' })`}>Get Started for Free →</Button>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-10 lg:py-20">
    <div class="wrap flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-10">
      <h2 class="flex-1 font-display text-display-3 text-gray-900 lg:text-display-2">Built for the way you run your shop</h2>
      <div class="hidden h-66 w-0.5 shrink-0 bg-gray-200 lg:block" aria-hidden="true"></div>
      <p class="flex-1 text-body-md text-gray-900/50 lg:text-body-lg">{industry.intro}</p>
    </div>
  </section>

  <ScrollFeatures features={features} label={`How SalesZote helps ${industry.name.toLowerCase()}`} />

  <FaqSection faqs={industry.faqs} />

  <QuickSetupCta
    source={`industry_${industry.slug}_cta`}
    title="Start selling in minutes."
    body="No new hardware, no training, no foreign pricing. SalesZote works with M-Pesa on the phone or computer you already use, with local support whenever you need it."
  />
</Layout>
