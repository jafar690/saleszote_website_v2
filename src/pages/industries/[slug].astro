---
import Layout from '../../layouts/Layout.astro';
import LandingHero from '../../components/landing/LandingHero.astro';
import FeatureGrid from '../../components/landing/FeatureGrid.astro';
import CtaBanner from '../../components/landing/CtaBanner.astro';
import Faqs from '../../components/home/Faqs.astro';
import { industries } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const url = `https://saleszote.com/industries/${industry.slug}`;

function stripHtml(html: string) {
  return html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://saleszote.com/' },
      { '@type': 'ListItem', position: 2, name: industry.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `SalesZote POS & Inventory for ${industry.name}`,
    description: industry.metaDescription,
    brand: { '@type': 'Brand', name: 'SalesZote' },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KES',
      availability: 'https://schema.org/InStock',
      description: 'Free 7-day trial, no credit card required.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: industry.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(faq.answer) },
    })),
  },
];
---
<Layout
  title={industry.metaTitle}
  description={industry.metaDescription}
  jsonLd={jsonLd}
>
  <LandingHero
    eyebrow={`For ${industry.name}`}
    title={industry.h1}
    sub={industry.heroSub}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: '/#industries' },
      { label: industry.name },
    ]}
    source={`industry_${industry.slug}_hero`}
  />

  <!-- Intro + pain points -->
  <section class="max-w-8xl mx-auto px-8 xl:px-30 py-10 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="rounded-2xl overflow-hidden h-64 sm:h-80 lg:h-96"
           style={`background-image:linear-gradient(180deg,rgba(0,0,0,0.00) 0%,rgba(0,0,0,0.35) 100%),url('${industry.image}');background-size:cover;background-position:center;`}>
      </div>
      <div>
        <h2 class="text-black text-2xl sm:text-4xl font-bold leading-10 mb-6">Built for the way you run your shop</h2>
        <p class="text-neutral-600 text-base font-medium leading-relaxed mb-8">{industry.intro}</p>
        <p class="text-black text-lg font-bold mb-4">Sound familiar?</p>
        <ul class="flex flex-col gap-4">
          {industry.painPoints.map((point) => (
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="#FEF1C3"/>
                <path d="M12 8v4m0 4h.01" stroke="#B04600" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span class="text-neutral-700 text-base font-medium leading-snug">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <FeatureGrid
    heading={`How SalesZote helps ${industry.name.toLowerCase()}`}
    intro="Everything you need to sell, track stock, and understand your business — in one simple system."
    features={industry.features}
  />

  <!-- Local trust band -->
  <section class="max-w-8xl mx-auto px-8 xl:px-30 py-14 lg:py-20 bg-green-white">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
      <h2 class="text-black text-2xl sm:text-4xl font-bold leading-10 mb-4">Made for Kenyan businesses</h2>
      <p class="text-neutral-600 text-base font-medium leading-relaxed">
        SalesZote supports M-Pesa, cash, and card payments, works on any phone or computer, and is backed by a local
        support team that understands how business works here. Prices are in KSh and setup takes minutes — no training needed.
      </p>
    </div>
  </section>

  <Faqs faqs={industry.faqs} showContactLink={true} />

  <CtaBanner
    title={`Ready to run your ${industry.name.toLowerCase()} smarter?`}
    text="Start selling in minutes with a system that feels instantly familiar. Free for 7 days, no credit card required."
    source={`industry_${industry.slug}_cta`}
  />
</Layout>
