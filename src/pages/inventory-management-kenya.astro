---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import TabletMockup from '../components/ui/TabletMockup.astro';
import VideoFeatures from '../components/sections/VideoFeatures.astro';
import WhoIsItFor from '../components/sections/WhoIsItFor.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import QuickSetupCta from '../components/sections/QuickSetupCta.astro';
import { DEMO_BOOKING_URL } from '../data/links';
import heroScreen from '../assets/inventory/hero-tablet-products.png';
import posterApprovePurchase from '../assets/inventory/posters/approve-purchase.png';
import posterLowStock from '../assets/inventory/posters/low-stock-alert.png';
import posterSwitchStore from '../assets/inventory/posters/switch-store.png';
import posterStockValue from '../assets/inventory/posters/stock-value.png';
import posterStockCount from '../assets/inventory/posters/stock-count.png';
import posterStockAdjustment from '../assets/inventory/posters/stock-adjustment.png';

const features = [
  { title: 'Real-time stock levels', body: 'Every sale and delivery updates your stock instantly, so your counts always match what is on the shelf.', video: 'inventory/approve-purchase', poster: posterApprovePurchase },
  { title: 'Low-stock alerts', body: 'Set a reorder level for each item and get warned before your best-sellers run out.', video: 'inventory/low-stock-alert', poster: posterLowStock },
  { title: 'Multiple stores & suppliers', body: 'Track stock across several outlets and record which supplier to reorder each item from.', video: 'inventory/switch-store', poster: posterSwitchStore },
  { title: 'Know your stock value', body: 'See how much money is sitting in stock and which items tie up cash without selling.', video: 'inventory/stock-value', poster: posterStockValue },
  { title: 'Stock counts made simple', body: 'Do regular stock takes and spot differences quickly, so shrinkage and errors do not go unnoticed.', video: 'inventory/stock-count', poster: posterStockCount },
  { title: 'Track who moves stock', body: 'See sales and stock changes by staff member, so nothing goes missing without a trace.', video: 'inventory/stock-adjustment', poster: posterStockAdjustment },
];

const faqs = [
  { question: 'What is an inventory management system?', answer: '<p>An inventory management system tracks what stock you have, what is running low, and what it is worth. SalesZote updates your stock automatically as you sell and receive goods, and it warns you before you run out.</p>' },
  { question: 'Can I manage stock across more than one shop?', answer: '<p>Yes. SalesZote lets you track inventory across multiple outlets and see performance for each one from a single dashboard.</p>' },
  { question: 'Will it tell me when to reorder?', answer: '<p>Yes. Set a reorder level for each item and SalesZote alerts you when stock falls low so you can reorder in time.</p>' },
  { question: 'Does inventory update automatically when I sell?', answer: '<p>Yes. Because SalesZote is a POS and inventory system in one, every sale reduces your stock in real time — no separate counting needed.</p>' },
  { question: 'How much does inventory software cost in Kenya?', answer: '<p>SalesZote plans start from KES 1,000 per month with a free 7-day trial and no credit card required. See the <a href="/pricing/">pricing page</a> for details.</p>' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://saleszote.com/' },
      { '@type': 'ListItem', position: 2, name: 'Inventory Management', item: 'https://saleszote.com/inventory-management-kenya' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SalesZote Inventory Management System',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, iOS, Android',
    description: 'Cloud inventory management system for shops and wholesalers in Kenya, with real-time stock tracking, low-stock alerts, and multi-store support.',
    url: 'https://saleszote.com/inventory-management-kenya',
    offers: { '@type': 'Offer', price: '1000', priceCurrency: 'KES', description: 'Plans from KES 1,000/month. Free 7-day trial.' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer.replace(/<[^>]+>/g, '').trim() },
    })),
  },
];
---
<Layout
  title="Inventory Management System in Kenya | Stock Control Software | SalesZote"
  description="Cloud inventory management for shops and wholesalers in Kenya. Track stock in real time, get low-stock alerts and manage multiple stores. Free for 7 days."
  jsonLd={jsonLd}
  navbarBg="bg-primary-50"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Solutions' },
    { label: 'Inventory Management' },
  ]}
>
  <section class="bg-primary-50">
    <div class="wrap flex flex-col items-center gap-10 py-10 lg:py-20">
      <div class="flex max-w-200 flex-col gap-2 text-center text-gray-900">
        <h1 class="font-display text-display-3 font-bold lg:text-display-2">Inventory Management System for Kenyan Businesses</h1>
        <p class="text-body-md text-gray-900/50">Track your stock in real time, get alerts before you run out, and know exactly what your inventory is worth — across one shop or many.</p>
      </div>
      <div class="flex w-full flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
        <Button href={DEMO_BOOKING_URL} target="_blank" rel="noopener noreferrer" variant="secondary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('demo_booking_clicked', { source: 'inventory_hero' })">Book a Demo</Button>
        <Button href="https://app.saleszote.com/register" variant="primary" size="lg" class="w-full sm:w-57.5" onclick="trackEvent('registration_started', { source: 'inventory_hero' })">Get Started for Free →</Button>
      </div>
      <TabletMockup screen={heroScreen} alt="SalesZote inventory on a tablet: the Products list with brands, categories and prices, and menus for categories, brands, units of measure and reorder levels" />
    </div>
  </section>

  <VideoFeatures
    title="Take control of your stock"
    intro="SalesZote keeps your inventory accurate automatically, so you spend less time counting and more time selling."
    features={features}
  />

  <WhoIsItFor title="Inventory built for your kind of business" subtitle="See how SalesZote handles stock for shops like yours." />

  <FaqSection faqs={faqs} />

  <QuickSetupCta
    source="inventory_cta"
    title={'Stop losing money to stock-outs and<br class="max-lg:hidden" /> dead stock.'}
    body="Know what's running low before it runs out, and what's sitting idle before it ties up your cash. Buy the right stock at the right time."
  />
</Layout>
