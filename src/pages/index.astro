---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import Features from '../components/home/Features.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import Industries from '../components/home/Industries.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faqs from '../components/home/Faqs.astro';
import MobileApps from '../components/home/MobileApps.astro';

import faqs from '../data/faqs.json';
import testimonials from '../data/testimonials.json';

function stripHtml(html: string) {
  return html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
}

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SalesZote',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, iOS, Android',
    description:
      'Cloud POS and inventory management system for shops and wholesalers in Kenya, with M-Pesa payments and real-time stock tracking.',
    url: 'https://saleszote.com',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KES',
      description: 'Free 7-day trial, no credit card required.',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripHtml(faq.answer),
      },
    })),
  },
];
---

<Layout jsonLd={jsonLd}>
    <HeroSection />
    <MobileApps />
    <Features />
    <WhyChooseUs />
    <Industries />
    <Testimonials testimonials={testimonials} />
    <Faqs faqs={faqs} showContactLink={true} />

    <section class="max-w-8xl mx-auto px-8 xl:px-30 bg-[#52154E] bg-[url('/images/backgrounds/bg3.svg')] bg-cover bg-no-repeat">
        <div class="grid grid-cols-2">
            <div class="col-span-2 lg:col-span-1 flex flex-col items-center lg:items-start py-20">
                <h3 class="text-center lg:text-start text-white text-2xl sm:text-4xl font-bold leading-loose sm:leading-10">
                    Quick Setup. No Training Needed
                </h3>

                <p class="text-center lg:text-start text-white text-base font-medium leading-snug mt-4">
                    Start selling in minutes with a system that feels instantly familiar. If you can use a phone, you can use SalesZote.
                </p>

                <div class="mt-9">
                    <a href="https://app.saleszote.com/register" onclick="trackEvent('registration_started', { source: 'home_cta' })" class="px-8 py-3 rounded-lg inline-flex bg-primary-500 border-1 border-primary-500 text-white text-base font-medium font-main leading-snug">
                        Get Started For Free
                    </a>
                </div>
            </div>
            <div class="hidden lg:flex flex-col items-end justify-end">
                <div>
                    <img src="/images/mobiles1.png" alt="SalesZote on mobile">
                </div>
            </div>
        </div>
    </section>
</Layout>
