{
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "saleszote_website_v2",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Dev copy of the site. Selected at build time: CLOUDFLARE_ENV=dev (see the deploy:dev script).
	"env": {
		"dev": {
			"name": "saleszote_website_v2-dev",
			"routes": [
				{
					"pattern": "web-dev.saleszote.com",
					"custom_domain": true
				}
			]
		}
	}
}